# Copy to .env and fill in from Supabase: Project Settings -> API.
# These two are safe for the browser because Row-Level Security protects the data.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# If the frontend uses Vite, it needs the VITE_ prefix to expose them:
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never ship to the browser. Use only inside serverless functions
# (exports, notifications, provisioning). Bypasses RLS — treat as a master key.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
